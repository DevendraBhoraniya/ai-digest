# Environment variables for the AI news digest.
# Copy to .env and fill in the values. Never commit .env.

# PostgreSQL / Neon connection string (required).
NEON_DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# Google Gemini API key (required).
GEMINI_API_KEY=

# Resend API key (required).
RESEND_API_KEY=

# Verified sender address for digest emails. Must be a verified Resend domain in production.
RESEND_FROM=onboarding@resend.dev

# Recipient of the daily digest (required).
DIGEST_RECIPIENT_EMAIL=

# Optional Webshare proxy credentials for transcript fetching.
PROXY_USERNAME=
PROXY_PASSWORD=
